{
  "name": "Java 25 Recettes",
  // On passe sur une image qui supporte les versions de pointe
  "image": "mcr.microsoft.com/devcontainers/base:debian-12", 
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installMaven": "true"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "java.configuration.runtimes": [
            {
                "name": "JavaSE-25",
                "path": "/usr/local/sdkman/candidates/java/25.0.2-ms",
                "default": true
            }
        ],
        "java.jdt.ls.java.home": "/usr/local/sdkman/candidates/java/25.0.2-ms"
      }
    }
  },
  "remoteUser": "vscode"
}